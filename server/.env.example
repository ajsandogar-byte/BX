# Copia este archivo como .env y llena los datos.
PUERTO=3000

DB_HOST=127.0.0.1
DB_PUERTO=3306
DB_USUARIO=bx
DB_PASSWORD=cambia-esto
DB_NOMBRE=bx

# Hora del corte diario (después de esta hora, las operaciones se registran al día siguiente).
HORA_CORTE=16:30

# Duración de la sesión en horas.
HORAS_SESION=12

# Pon 1 cuando el sistema se sirva por HTTPS.
COOKIE_SEGURA=0

# Carpeta con la aplicación web compilada (se llena en la siguiente etapa).
# CARPETA_WEB=../web/dist
