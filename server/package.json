{
  "name": "bx-server",
  "version": "0.1.0",
  "private": true,
  "description": "API de BX: saldos de clientes y proveedores, cajas multimoneda y cortes.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file=.env src/index.js",
    "dev": "node --env-file=.env --watch src/index.js",
    "migrar": "node --env-file=.env db/migrar.js",
    "crear-admin": "node --env-file=.env db/crear-admin.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\""
  },
  "dependencies": {
    "mysql2": "^3.11.0",
    "zod": "^3.23.8"
  }
}
